{
  "name": "pi05-arena-droid-v1",
  "purpose": "paired pretrained RGB and native RAW deployment acceptance, not full benchmark",
  "environment": "pick_and_place_maple_table",
  "embodiment": "droid_abs_joint_pos",
  "object": "rubiks_cube_hot3d_robolab",
  "destination": "bowl_ycb_robolab",
  "hdr": "home_office_robolab",
  "instruction": "Pick up the Rubik's cube and place it in the bowl.",
  "policy_config": "pi05_droid_jointpos_polaris",
  "checkpoint": "gs://openpi-assets-simeval/pi05_droid_jointpos",
  "inference_seed": 7,
  "environment_seeds": [0, 1, 2],
  "episodes_per_seed": 1,
  "episode_limit_seconds": 70,
  "action_chunk_length": 15,
  "fine_tuning": false,
  "torch_compile": false,
  "raw": {
    "enabled_in_phase": "raw",
    "camera_views": ["external_camera", "wrist_camera"],
    "width": 1280,
    "height": 720,
    "phase": "pre_action, every control step, extra render without physics advance",
    "cfa": "GRBG",
    "bit_depth": 24,
    "container": "uint32",
    "hdr_container": "float16",
    "noise": "native default uncalibrated; stored separately",
    "physical_sensor_calibration": false
  }
}
