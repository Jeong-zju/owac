{
  "name": "n04-tiny",
  "comment": "N04 staged research: repaired data, sensor reference with matched support, gain explanation, joint conditions. Mechanism acceptance is evaluated separately.",
  "input_mode": "rawvla_rgb3",
  "measurement_size": [
    64,
    64
  ],
  "channels": 3,
  "camera_ids": [
    "head"
  ],
  "seed": 0,
  "geometry": {
    "feature_size": [
      64,
      64
    ],
    "pixel_stride": 1.0,
    "max_flow": 8.0
  },
  "model": {
    "name": "n04-tiny",
    "width": 32,
    "blocks": 2,
    "scales": 2,
    "scale_strides": [
      1,
      2
    ],
    "coarse_stride": 4,
    "hidden": 64,
    "camera_embedding": 8,
    "readout_tokens": 64,
    "readout_dim": 128,
    "predictor": "learned_proprio",
    "use_previous_features": true,
    "illumination_branch": true,
    "change_branch": true,
    "loss_weights": {
      "location": 1.0,
      "future_measurement": 0.5,
      "change": 0.1,
      "ego_warp": 0.1
    },
    "innovation_reference": "sensor_history",
    "match_observation_support": true,
    "illumination_explanation": true
  },
  "train": {
    "sequence_length": 12,
    "tbptt": 8,
    "batch_size": 4,
    "steps": 200,
    "lr": 0.0003,
    "grad_clip": 1.0,
    "burn_in": 2,
    "log_every": 25,
    "seed": 0,
    "device": "cpu",
    "synthetic": {
      "camera_translation": [
        1.2,
        1.2
      ],
      "camera_rotation": [
        0.0,
        0.4
      ],
      "object_velocity": [
        0.8,
        1.2
      ],
      "illumination": [
        0.7,
        1.3
      ],
      "noise_sigma": 0.01,
      "action_delay": 2,
      "calibration_scale": 1.08,
      "conditions": [
        "camera_only",
        "object_only",
        "both",
        "illumination",
        "same_direction",
        "occlusion",
        "calibration_error",
        "action_delay",
        "exposure_step",
        "static",
        "camera_illumination",
        "object_illumination",
        "both_illumination"
      ]
    },
    "threads": 4
  }
}
