    "buckets": {
      "translation_subpixel": "fast_alignable",
      "exposure_gain": "fast_alignable",
      "motion_blur": "fast_alignable",
      "repeated_texture": "fast_hard",
      "layered_occlusion": "fast_hard",
      "local_nonrigid": "slow_structural_change",
      "rotation": "slow_structural_change",
      "combined_hard": "current_frame_anomaly"
    },
    "simplified_search_px": 12,
    "risk_bins": 4,
    "risk_quantile": 0.9,
    "risk_margin_sensor_px": 1.0,
    "risk_tolerance_sensor_px": 1.0,
    "static_false_rejection_sensor_px": 0.5,
    "latency_warmup": 2,
    "latency_repeats": 5,
    "max_calibration_pairs": 32,
    "max_validation_pairs": 32,
    "max_test_pairs": 32,
    "display_batch": 4
  },
  "notes": "P2 RAW motion training. The shipped noise-config geometry (64x64 sensor -> 32x32 packed for CFA) is below the vendored 4-level correlation pyramid minimum of 128 packed cells per side at iters>0, so this config declares a 256x256 sensor override and scales every pixel-valued scene length by 4 to preserve the declared relative motion, occlusion size and texture scale; translation_subpixel sequence tokens are absolute declarations and are not scaled. The two LR tiers and the iteration tiers come from the pinned author recipe (config/train/Tartan-C368x496-M.json: lr 2.5e-4, iters 4); the formal budget is the authorised first segment of 100k updates with the author 100k-300k range as the ceiling."
}
